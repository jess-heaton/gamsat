# Copy this file to .env.local and fill in your key.
# .env.local is gitignored — your key never gets committed.

# Anthropic API key — used server-side only (app/api/mark-essay/route.js)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for essay marking.
# Defaults to claude-opus-4-8 if unset.
ANTHROPIC_MODEL=claude-opus-4-8
